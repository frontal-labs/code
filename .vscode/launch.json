{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Frontal Code CLI",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/frontal-code",
      "args": [],
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "RUST_LOG",
          "value": "debug"
        },
        {
          "name": "CARGO_TERM_COLOR",
          "value": "always"
        }
      ],
      "console": "integratedTerminal",
      "preLaunchTask": "cargo build debug"
    },
    {
      "name": "Debug Frontal Code REPL",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/frontal-code",
      "args": ["--model", "sonnet"],
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "RUST_LOG",
          "value": "debug"
        }
      ],
      "console": "integratedTerminal",
      "preLaunchTask": "cargo build debug"
    },
    {
      "name": "Debug Frontal Code Prompt",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/frontal-code",
      "args": ["prompt", "summarize this repository"],
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "RUST_LOG",
          "value": "debug"
        }
      ],
      "console": "integratedTerminal",
      "preLaunchTask": "cargo build debug"
    },
    {
      "name": "Debug Mock Parity Harness",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/frontal-code",
      "args": ["--provider", "mock", "prompt", "test streaming"],
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "RUST_LOG",
          "value": "debug"
        },
        {
          "name": "MOCK_ANTHROPIC_SERVICE_URL",
          "value": "http://127.0.0.1:8765"
        }
      ],
      "console": "integratedTerminal",
      "preLaunchTask": "cargo build debug"
    },
    {
      "name": "Debug Mock Service",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/mock-gateway",
      "args": ["--bind", "127.0.0.1:8765"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "cargo build mock service"
    }
  ]
}
