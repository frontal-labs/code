{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "extends": ["./ultracite.json"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/target",
      "!**/dist",
      "!**/.frontal-code",
      "!**/coverage",
      "!**/bazel-bin",
      "!**/bazel-out",
      "!**/bazel-testlogs",
      "!**/bazel-*",
      "!**/src/generated",
      "!**/*.lock",
      "!**/*.sum"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["**/sdks/typescript/**", "**/sdks/typescript/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noExplicitAny": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off"
          }
        }
      }
    }
  ]
}
