package(default_visibility = ["//visibility:public"])

filegroup(
    name = "srcs",
    srcs = glob(
        ["**/*.rs"],
        exclude = ["**/target/**"],
    ) + ["Cargo.toml"],
)

filegroup(
    name = "test_srcs",
    srcs = glob(["tests/**/*.rs"]),
)

sh_binary(
    name = "code",
    srcs = ["//tools:crate.sh"],
    args = [
        "cli",
        "run",
    ],
)

# The same CLI under its second name. `frontal-code` runs the `code` beside it.
sh_binary(
    name = "frontal-code",
    srcs = ["//tools:crate.sh"],
    args = [
        "cli",
        "run",
        "--bin",
        "frontal-code",
    ],
)

sh_test(
    name = "test",
    timeout = "eternal",
    size = "large",
    srcs = ["//tools:crate.sh"],
    data = ["//:cargo_workspace"],
    args = [
        "cli",
        "test",
    ],
    tags = [
        "rust",
        "test",
    ],
)

sh_test(
    name = "fmt",
    size = "small",
    srcs = ["//tools:crate.sh"],
    data = ["//:cargo_workspace"],
    args = [
        "cli",
        "fmt-check",
    ],
    tags = [
        "fmt",
        "rust",
    ],
)

sh_test(
    name = "lint",
    timeout = "eternal",
    srcs = ["//tools:crate.sh"],
    data = ["//:cargo_workspace"],
    args = [
        "cli",
        "clippy",
    ],
    tags = [
        "lint",
        "rust",
    ],
)
