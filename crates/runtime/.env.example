# Runtime Configuration
# Copy this file to .env and customize for your runtime environment

# Configuration Directories
FCODE_CONFIG_HOME=~/.frontal-code
FCODE_HOME=~/.frontal-code
HOME=~/

# Sandbox Configuration
FCODE_SANDBOX_HOME=~/.frontal-code/sandbox
SANDBOX_HOME=~/.frontal-code/sandbox
# Enable Docker fallback backend explicitly (default: disabled)
FCODE_SANDBOX_ENABLE_DOCKER=0
# Optional Docker image override when FCODE_SANDBOX_ENABLE_DOCKER=1
FCODE_SANDBOX_DOCKER_IMAGE=busybox:1.36

# System Paths (ensure these are available in your PATH)
PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

# Optional: Auto-compaction threshold for conversations
# AUTO_COMPACTION_THRESHOLD=100

# OAuth & Authentication Storage
# Credentials will be stored in FCODE_CONFIG_HOME/oauth/ by default
