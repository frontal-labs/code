# Sandbox crate environment configuration
# Copy this file to .env when validating sandbox behavior locally

# Enable Docker fallback backend explicitly (default: disabled)
FCODE_SANDBOX_ENABLE_DOCKER=0

# Docker image used by the sandbox Docker backend when enabled
FCODE_SANDBOX_DOCKER_IMAGE=busybox:1.36

# Optional paths set in sandboxed commands
FCODE_SANDBOX_HOME=~/.frontal-code/sandbox
SANDBOX_HOME=~/.frontal-code/sandbox
