package(default_visibility = ["//visibility:public"])

filegroup(
    name = "srcs",
    srcs = glob(
        ["**/*"],
        exclude = [
            "**/target/**",
            "BUILD.bazel",
        ],
    ),
)

sh_test(
    name = "core_config_example",
    srcs = ["//tools:crate.sh"],
    args = [
        "frontal-code-core",
        "run",
        "--example",
        "core_config_example",
    ],
    tags = [
        "example",
        "rust",
    ],
)
