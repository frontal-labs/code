{
  "name": "code-slack",
  "version": "0.1.0",
  "description": "Frontal Code Slack agent for autonomous coding operations",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "bun scripts/check-code-events.mjs || true",
    "build": "bun build --target node --minify --external pg-native src/main.ts src/migrate.ts --outdir dist",
    "build:dev": "bun build --target node --sourcemap --external pg-native src/main.ts src/migrate.ts --outdir dist",
    "sync:code-events": "cargo run -p code-events --bin export-typescript -- src/generated/code-events.ts",
    "start": "node dist/main.js",
    "start:bun": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "dev:hot": "bun --watch --hot src/main.ts",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "ci": "tsc --noEmit -p tsconfig.json && vitest run --coverage && biome ci src/",
    "migrate": "bun src/migrate.ts"
  },
  "homepage": "https://github.com/frontal-labs/code",
  "bugs": {
    "url": "https://github.com/frontal-labs/code/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/code.git",
    "directory": "extensions/code-slack"
  },
  "keywords": [
    "slack",
    "frontal-code",
    "bot",
    "agent",
    "autonomous",
    "ai"
  ],
  "author": "Frontal Labs",
  "license": "Apache-2.0",
  "dependencies": {
    "@sentry/node": "^11.8.0",
    "@slack/bolt": "^3.21.0",
    "@slack/web-api": "^6.12.0",
    "@t3-oss/env-core": "^0.13.11",
    "axios": "^1.20.0",
    "ocp-sdk": "^2.2.1",
    "pg": "^8.23.1",
    "qs": "^6.16.0",
    "winston": "^3.11.0",
    "ws": "^8.20.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "jsdom": "^23.0.1",
    "msw": "^2.2.3",
    "typescript": "~5.9",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18.0",
    "bun": ">=1.0.0"
  },
  "overrides": {
    "body-parser": "^1.20.9",
    "qs": "^6.16.0"
  }
}
