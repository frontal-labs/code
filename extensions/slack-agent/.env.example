# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
# SLACK_SIGNING_SECRET is optional in Socket Mode and can be omitted.

# Slack Access Control
# Comma-separated Slack user IDs allowed to start tasks. EMPTY DENIES ALL TASK CREATION.
SLACK_ALLOWED_USER_IDS=U0123456789
# Comma-separated Slack channel IDs where @mentions and /code may start tasks.
# Empty allows any channel (for allowlisted users). DMs are not channel-restricted.
SLACK_ALLOWED_CHANNEL_IDS=
# Comma-separated Slack user IDs (must also be in SLACK_ALLOWED_USER_IDS) that may
# approve, retry, or cancel tasks created by other users.
SLACK_ADMIN_USER_IDS=

# Frontal Code API Configuration
# For development with tools.frontal.dev infrastructure:
FRONTAL_CODE_API_URL=http://code-server:8788
# For local development:
# FRONTAL_CODE_API_URL=http://localhost:8788
# For production:
# FRONTAL_CODE_API_URL=https://tools.frontal.dev/code
FRONTAL_CODE_API_TIMEOUT=30000
FRONTAL_SERVER_API_KEY=replace-with-your-code-api-key

# OpenChannel Protocol (@openchannelprotocol/sdk) event store - REQUIRED
# Every Slack request, bot message, and Frontal Code action is recorded here.
OCP_DATABASE_URL=postgres://frontal_code_slack:frontal_code_slack@localhost:5432/frontal_code_slack
# Optional: event table name (lowercase identifier).
OCP_EVENTS_TABLE=ocp_events
# Optional: set to false when a deploy step runs `node dist/migrate.js` before startup.
OCP_RUN_MIGRATIONS=true
# Optional: OCP actor ID of the Frontal Code agent.
OCP_AGENT_ID=agent:frontal-code

# Application Configuration
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# GitHub Integration (Optional)
GITHUB_TOKEN=your-github-token
LINEAR_TOKEN=
LINEAR_API_URL=https://api.linear.app/graphql
GRAPHITE_TOKEN=
GRAPHITE_API_URL=https://graphite.dev/api

# Sentry Configuration (Optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Advanced Configuration
MAX_CONCURRENT_TASKS=10
TASK_TIMEOUT=3600000
HEALTH_CHECK_INTERVAL=30000

# Development Environment Configuration
# When deploying with tools.frontal.dev infrastructure:
# - Use http://code-server:8788 for internal communication
# - External access will be through https://tools.frontal.dev/code
# - Webhooks should be configured to https://tools.frontal.dev/code/webhooks/slack

# Production Environment Configuration
# - Use https://tools.frontal.dev/code for FRONTAL_CODE_API_URL
# - Ensure SLACK_BOT_TOKEN has necessary permissions
# - Configure SENTRY_DSN for error tracking
