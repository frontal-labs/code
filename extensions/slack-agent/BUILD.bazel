package(default_visibility = ["//visibility:public"])

filegroup(
    name = "srcs",
    srcs = glob(
        [
            "src/**/*",
            "scripts/**/*",
            "tests/**/*",
            "package.json",
        ],
        exclude = [
            "node_modules/**",
            "dist/**",
            "coverage/**",
            "BUILD.bazel",
        ],
    ),
)

filegroup(
    name = "config_srcs",
    srcs = [
        "bun.lock",
        "bunfig.toml",
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
    ],
)

sh_test(
    name = "lint",
    size = "small",
    srcs = ["//tools:extension.sh"],
    data = [":srcs", ":config_srcs", "//:biome.json", "//:ultracite.json", "//:.gitignore"],
    args = [
        "extensions/slack-agent",
        "lint",
    ],
    tags = [
        "lint",
        "typescript",
    ],
)

sh_test(
    name = "build",
    srcs = ["//tools:extension.sh"],
    data = [":srcs", ":config_srcs", "//:biome.json", "//:ultracite.json", "//:.gitignore"],
    args = [
        "extensions/slack-agent",
        "build",
    ],
    tags = [
        "build",
        "typescript",
    ],
)

sh_test(
    name = "test",
    srcs = ["//tools:extension.sh"],
    data = [":srcs", ":config_srcs", "//:biome.json", "//:ultracite.json", "//:.gitignore"],
    args = [
        "extensions/slack-agent",
        "test",
    ],
    tags = [
        "test",
        "typescript",
    ],
)
