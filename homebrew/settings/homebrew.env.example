# HOMEBREW_* environment variable names (no secrets).
#
# Copy this file to `homebrew.env` (or source it from your shell) and fill in
# values appropriate for this machine. Tokens/credentials must never be
# committed; store them in the keychain or CI secret store.
#
# Convention: uncomment and set only the variables you want to override.
# Leave the rest commented so Homebrew defaults apply.

# HOMEBREW_NO_AUTO_UPDATE=1
# HOMEBREW_NO_INSTALL_CLEANUP=1
# HOMEBREW_NO_ENV_HINTS=1
# HOMEBREW_NO_ANALYTICS=1
# HOMEBREW_DEVELOPER=1
# HOMEBREW_GIT=/opt/homebrew/bin/git
# HOMEBREW_EDITOR=vim
# HOMEBREW_BROWSER=open
# HOMEBREW_PREFIX=/opt/homebrew
# HOMEBREW_CELLAR=/opt/homebrew/Cellar
# HOMEBREW_REPOSITORY=/opt/homebrew
# HOMEBREW_LIBRARY_PATH=/opt/homebrew/Library/Homebrew
# HOMEBREW_CACHE=/Users/gabrielfonseca/Library/Caches/Homebrew
# HOMEBREW_LOGS=/Users/gabrielfonseca/Library/Logs/Homebrew
# HOMEBREW_TEMP=/tmp
# HOMEBREW_BUNDLE_FILE=homebrew/Brewfile
# HOMEBREW_NO_INSTALL_FROM_API=1
# HOMEBREW_TRUSTED_CASKS=coder/coder/coder-desktop
