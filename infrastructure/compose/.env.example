# Frontal Code server
FRONTAL_CODE_SERVER_HOST=0.0.0.0
FRONTAL_CODE_SERVER_PORT=8788
FRONTAL_CODE_SERVER_PUBLISH_ADDR=127.0.0.1
FRONTAL_CODE_SERVER_LANE_TRANSPORT=tools-agent
FRONTAL_CODE_SERVER_API_KEY=replace-with-a-long-random-api-key
FRONTAL_CODE_SERVER_WORKSPACE_ROOT=/workspace/workspaces
FRONTAL_CODE_SERVER_DOCKER_IMAGE=frontal-code-worker:local
# Set FRONTAL_CODE_SERVER_PUBLISH_ADDR=0.0.0.0 if external hosts or Linux worker callbacks must reach the published port.
FRONTAL_CODE_SERVER_CALLBACK_URL=http://host.docker.internal:8788
FRONTAL_CODE_SERVER_RECONCILE_INTERVAL_SECS=15
FRONTAL_CODE_SERVER_ORPHAN_APPROVAL_DELAY_SECS=0
FRONTAL_CODE_SERVER_ORPHAN_AUTO_RETRY_SECS=0
FRONTAL_CODE_SERVER_ORPHAN_AUTO_CANCEL_SECS=0
FRONTAL_CODE_SERVER_ORPHAN_POLICY_RULES=[]
FRONTAL_CODE_SERVER_STATE_FILE=/var/lib/frontal-code/server/state.json
FRONTAL_CODE_AGENT_STORE=/var/lib/frontal-code/agents
RUST_LOG=info
FRONTAL_CODE_GITHUB_WEBHOOK_SECRET=
FRONTAL_CODE_LINEAR_API_TOKEN=
FRONTAL_CODE_LINEAR_API_URL=https://api.linear.app/graphql
FRONTAL_CODE_LINEAR_WEBHOOK_SECRET=
FRONTAL_CODE_GRAPHITE_API_TOKEN=
FRONTAL_CODE_GRAPHITE_API_URL=https://graphite.dev/api
FRONTAL_CODE_GRAPHITE_WEBHOOK_SECRET=

# AI providers
FRONTAL_API_KEY=
FRONTAL_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
FRONTAL_API_KEY=
FRONTAL_BASE_URL=
XAI_API_KEY=
XAI_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=
BEDROCK_API_KEY=
BEDROCK_BASE_URL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Slack connector
FRONTAL_CODE_API_URL=http://frontal-code-server:8788
FRONTAL_CODE_API_TIMEOUT=30000
FRONTAL_SERVER_API_KEY=replace-with-the-same-frontal-code-server-api-key
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=replace-with-a-real-32-char-secret
NODE_ENV=production
LOG_LEVEL=info
PORT=3000
MAX_CONCURRENT_TASKS=10
TASK_TIMEOUT=3600000
HEALTH_CHECK_INTERVAL=30000
GITHUB_TOKEN=
SENTRY_DSN=
