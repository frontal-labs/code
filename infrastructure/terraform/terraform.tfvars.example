# AWS Configuration
aws_region = "us-east-1"
environment = "development"
aws_account_id = "123456789012"

# EKS Cluster
eks_cluster_name = "frontal-code-dev-cluster"
eks_cluster_auth_name = "frontal-code-dev-cluster"

# Networking
vpc_id = "vpc-xxxxxxxxx"

# SSL Certificate (must exist in ACM)
certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Kubernetes
frontal-code_service_namespace = "frontal-code"

# Deployment Configuration
deploy_frontal-code_server = true
deploy_frontal-code_slack = true

# Container Images
frontal-code_server_image = "frontal-code-server:v0.1.0"
frontal-code_slack_image = "frontal-code-slack:v0.1.0"
frontal-code_server_api_key = "replace-with-a-long-random-api-key"

# Slack Configuration
slack_bot_token = "xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxx"
slack_app_token = "xapp-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxx"
slack_signing_secret = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional Integrations
github_token = ""  # GitHub token for Slack integration
sentry_dsn = ""    # Sentry DSN for error tracking

# API Keys (optional)
api_keys = {
  anthropic = "sk-ant-xxxxxxxxxxxx"
  openai = "sk-xxxxxxxxxxxx"
  xai = "xxxxxxxxxxxx"
  azure = "xxxxxxxxxxxx"
  bedrock = "xxxxxxxxxxxx"
  ollama = ""
}

# Storage Configuration
storage_class = "gp3"
workspace_storage_size = "100Gi"
server_state_storage_size = "10Gi"
agent_store_storage_size = "50Gi"
