package(default_visibility = ["//visibility:public"])

# Shell scripts are Bazel entrypoints for local development and CI.
exports_files([
    "bootstrap.sh",
    "build.sh",
    "test.sh",
    "fmt.sh",
    "lint.sh",
    "tidy.sh",
    "doctor.sh",
    "clean.sh",
    "ci.sh",
    "coverage.sh",
    "third_party_check.sh",
    "changeset_check.sh",
    "cache.sh",
    "workspace.sh",
    "version.sh",
    "bench.sh",
    "telemetry.sh",
    "codegen.sh",
    "generators.sh",
    "remote.sh",
    "fuzz.sh",
    "cli.sh",
    "changeset.sh",
    "renovate.sh",
])

sh_test(
    name = "third_party_check",
    srcs = ["third_party_check.sh"],
    data = ["//:MODULE.bazel", "//third_party:repos.bzl"],
    tags = ["check"],
)

sh_test(
    name = "changeset_check",
    srcs = ["changeset_check.sh"],
    tags = ["check"],
)

sh_binary(name = "cli", srcs = ["cli.sh"])
sh_binary(name = "changeset", srcs = ["changeset.sh"])
sh_binary(name = "renovate", srcs = ["renovate.sh"])
