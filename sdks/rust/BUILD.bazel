load("//tools:lint.bzl", "rust_lint")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "rust_sdk_srcs",
    srcs = glob(
        ["**/*"],
        exclude = [
            "target/**",
            "BUILD.bazel",
        ],
    ),
)

# Format check for the Rust SDK.
sh_test(
    name = "fmt",
    size = "small",
    srcs = ["//tools:sdk_rust.sh"],
    data = ["//:cargo_workspace"],
    args = ["fmt-check"],
    tags = ["fmt", "rust"],
)

# Clippy (with -D warnings) for the Rust SDK.
rust_lint(
    name = "lint",
    crate = "frontal-code-sdk",
)

# Run the SDK's test suite.
sh_test(
    name = "test",
    srcs = ["//tools:sdk_rust.sh"],
    args = ["test"],
    tags = ["rust", "test"],
)
