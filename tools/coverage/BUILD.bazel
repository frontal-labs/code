package(default_visibility = ["//visibility:public"])

# Canonical coverage entrypoint (runs `bazel coverage //...`, then aggregates).
sh_binary(
    name = "coverage",
    srcs = ["coverage.sh"],
)

# Rust lcov aggregator used by coverage.sh.
sh_binary(
    name = "tools-coverage",
    srcs = ["//tools:cargo_run.sh"],
    args = ["tools-coverage"],
)

exports_files(["coverage.sh"])
